        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    
    var incidents = new GlideRecord('incident');
    incidents.addQuery('problem_id', current.getUniqueValue());
    incidents.query();

    while (incidents.next()) {
        
        if (incidents.state != 6 && incidents.state != 7) {
            
            var commentText = "Related Problem " + current.getValue('number') + " has been closed/resolved.\n";
            commentText += "Problem Close Notes: " + current.getValue('close_notes') + "\n";
            commentText += "Problem Work Note: " + current.work_notes.getJournalEntry(1); 
            
            incidents.comments = commentText;
            
            incidents.state = 6; 
            incidents.close_code = 'Resolved by problem';
            incidents.close_notes = current.getValue('close_notes');
            incidents.update();
            
        } else {
            incidents.work_notes = "The root cause for this incident has been identified and closed in Problem " + current.getValue('number') + ".";
            incidents.update();
        }
    }

})(current, previous);]]></script>
